{
  "name": "api-for-cursor",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Linux headless OpenAI-compatible Chat Completions and Responses API for Cursor.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/standardagents/composer-api.git"
  },
  "homepage": "https://github.com/standardagents/composer-api#readme",
  "bugs": {
    "url": "https://github.com/standardagents/composer-api/issues"
  },
  "scripts": {
    "server": "bun run server/index.ts",
    "server:bridge": "node scripts/cursor-sdk-local-agent-bridge.mjs",
    "server:up": "docker compose up --build -d",
    "server:down": "docker compose down",
    "server:logs": "docker compose logs -f api bridge",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit"
  },
  "keywords": [
    "cursor",
    "composer",
    "openai",
    "chat-completions",
    "responses-api",
    "linux"
  ],
  "license": "MIT",
  "dependencies": {
    "@cursor/sdk": "^1.0.13"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
