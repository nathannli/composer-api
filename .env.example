ENCRYPTION_KEY="replace-with-a-long-random-secret"
CURSOR_BACKEND_BASE_URL=""
CURSOR_CHAT_ENDPOINT=""
CURSOR_SDK_BRIDGE_URL=""
CURSOR_SDK_BRIDGE_TOKEN=""
CURSOR_SDK_BRIDGE_RUN_TIMEOUT_MS="180000"
CURSOR_SDK_BRIDGE_REQUEST_TIMEOUT_MS="900000"
CURSOR_SDK_CONTEXT_WINDOW_REFRESH_MS="900000"
SHUTDOWN_GRACE_MS="10000"
CURSOR_CLIENT_VERSION="2.6.22"

# --- Local OpenAI-compatible server (Bun API + SDK bridge) ---
# Default PORT=8788 avoids hermes-webui on :8787.
# HOST=127.0.0.1
# PORT=8788
# CURSOR_SDK_BRIDGE_URL=http://127.0.0.1:8792/sdk
# CURSOR_SDK_WORKING_DIRECTORY=/path/to/project
# CURSOR_SDK_WORKSPACE_HOST=/path/to/project
# Optional shared cache populated from checkpoint.tokenDetails.maxTokens:
# CURSOR_SDK_CONTEXT_WINDOWS_FILE=/path/to/context-windows.json
# Optional comma-separated allowlist for discovery and request enforcement.
# Recommended when Hermes has a short models: list (keeps live discovery in sync):
# COMPOSER_API_MODELS=composer-2.5,grok-4.5
# Cursor secret used by the server when LOCAL_API_KEY gateway mode is on:
# CURSOR_API_KEY=
# Optional key for Hermes / local clients (recommended). Clients send this as Bearer.
# LOCAL_API_KEY=
